APP_NAME="Kyrios"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kyrios.leongrup.com
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Base de datos de Hostinger (hPanel > Bases de datos). La contraseña se escribe solo en el .env del servidor.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u188616411_kyrios_test
DB_USERNAME=u188616411_kyrios_test
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@leongrup.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Usuario administrador inicial (lo crea AdminUserSeeder)
ADMIN_NAME="Administrador"
ADMIN_EMAIL=
ADMIN_PASSWORD=

MASTER_PASSWORD=
SISTEMA_BLOQUEADO=false
APIS_NET_PE_TOKEN=
VENTA_EDIT_WINDOW_HOURS=24
VENTA_CREDITO_MAX_CUOTAS=24
